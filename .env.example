# Database (Local Postgres via Docker)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=releaseshield
POSTGRES_PORT=5432

# (Alternative) Supabase or Managed Postgres
# If you provide DATABASE_URL, it will override the individual variables above.
# DATABASE_URL=postgresql://postgres.yourproject:password@aws-0-region.pooler.supabase.com:6543/postgres

# GitHub Authentication
GITHUB_TOKEN=your_github_token_here


# LLM Authentication
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-pro
